# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shopify Storefront API (Público)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# Shopify Admin API (Privado - Apenas servidor)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token

# Supabase service role (Privado - Apenas servidor)
# Sem ela, toda rota que grava pelo servidor responde erro.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo dos webhooks da Shopify: a chave shpss_ do app (API secret key),
# não o token shpat_. Sem ela, /api/webhooks/shopify e
# /api/subscription/webhook recusam TODA requisição com 401.
SHOPIFY_WEBHOOK_SECRET=

# Segredo de /api/revalidate?secret=... Sem ele a rota responde 503.
REVALIDATE_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexação por buscadores. Fechado por padrão.
# Em Production na Vercel, definir como true. Sem isso o site inteiro sai com
# noindex e o robots.txt com "Disallow: /".
NEXT_PUBLIC_ALLOW_INDEXING=

# Analytics (Opcional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
