# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shopify Storefront API (Público)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-token

# Shopify Admin API (Privado - Apenas servidor)
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token

# Supabase service role (Privado - Apenas servidor)
# Sem ela, toda rota que grava pelo servidor responde erro.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo dos webhooks da Shopify: a chave shpss_ do app (API secret key),
# não o token shpat_. Sem ela, /api/webhooks/shopify e
# /api/subscription/webhook recusam TODA requisição com 401.
SHOPIFY_WEBHOOK_SECRET=

# Segredo de /api/revalidate?secret=... Sem ele a rota responde 503.
REVALIDATE_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexação por buscadores. Fechado por padrão.
# Em Production na Vercel, definir como true. Sem isso o site inteiro sai com
# noindex e o robots.txt com "Disallow: /".
NEXT_PUBLIC_ALLOW_INDEXING=

# Analytics (GA4). ID de fluxo no formato G-XXXXXXXXXX.
# O site aceita os dois nomes; prefira NEXT_PUBLIC_GA_MEASUREMENT_ID.
# Vazio ou com o marcador de exemplo, nada é medido.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GA_ID=

# E-mail do formulário de contato (/contato e /representantes), via Resend.
# As TRÊS são obrigatórias. Faltando qualquer uma, /api/contact responde 503 e
# os formulários mostram erro em vez de "mensagem enviada".
# Chave da API do Resend (Privado - Apenas servidor)
RESEND_API_KEY=
# Caixa que recebe as mensagens do site
EMAIL_CONTATO=
# Remetente, em domínio verificado no Resend. Ex.: Terravik <site@terravik.com.br>
EMAIL_REMETENTE=

# Análise por foto na calculadora (/calculadora). Sem a chave, o caminho da foto
# não aparece e a calculadora segue só com as perguntas.
# Exige também SUPABASE_SERVICE_ROLE_KEY e a migration
# 20261012000000_calculadora_foto_uso.sql aplicada (cota diária).
# Chave da API da Anthropic (Privado - Apenas servidor)
ANTHROPIC_API_KEY=

# Versão da API da Shopify (Storefront e Admin). Sem ela, o código usa 2024-10.
# NEXT_PUBLIC_SHOPIFY_API_VERSION=2024-10

# Hook de e-mail do Supabase (Authentication, Hooks, Send Email Hook).
# Segredo mostrado no painel do Supabase ao criar o hook ("v1,whsec_...").
# Com o hook LIGADO no painel e esta variavel ausente ou errada, ninguem
# recebe e-mail de cadastro nem de recuperacao de senha. Ligue o hook so com
# o diagnostico de /admin/emails verde.
SUPABASE_AUTH_HOOK_SECRET=

# Webhook do Resend (resend.com/webhooks), apontando para
# /api/webhooks/resend. Segredo "whsec_..." mostrado ao criar o webhook.
# Sem ele os e-mails saem, mas o status em /admin/emails fica em "enviado".
RESEND_WEBHOOK_SECRET=
